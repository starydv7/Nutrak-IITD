{
  "expo": {
    "name": "iitdelhi",
    "slug": "iitdelhi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nutrak-child.png",
    "scheme": "iitdelhi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/nutrak-child.png",
        "backgroundImage": "./assets/images/nutrak-child.png",
        "monochromeImage": "./assets/images/nutrak-child.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.starydv7.iitdelhi"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/nutrak-child.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/nutrak-child.png",
          "imageWidth": 76
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f5a69226-05d3-424f-a8a3-de9308be5a04"
      }
    }
  }
}
